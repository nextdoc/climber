{
  "name": "salesforce-app",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce App",
  "scripts": {
    "prettier": "prettier --write \"**/*.{cls,json,md,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,json,md,trigger,xml,yaml,yml}\"",
    "score": "bun cli/score.ts -a 'force-app/**/classes/*.cls' -t 'force-app/**/classes/*Test.cls' 'force-app/**/classes/Fixtures.cls' --headroom-test AccountHealthRollupTest.headroomAt200Accounts",
    "score:prepare": "cli/score-prepare.sh climb-your-apex target/tmp/score AccountHealthRollupTest"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-apex": "2.3.0"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "type": "module"
}
