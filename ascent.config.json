{
  "app": [
    "force-app/**/classes/AccountHealthRollup.cls",
    "force-app/**/classes/CaseSlaEscalation.cls"
  ],
  "test": [
    "force-app/**/classes/*Test.cls",
    "force-app/**/classes/Fixtures.cls",
    "force-app/**/classes/CaseFixtures.cls"
  ],
  "testClasses": {
    "sample": ["AccountHealthRollupTest", "CaseSlaEscalationTest"],
    "holdout": []
  },
  "headroomTest": [
    "AccountHealthRollupTest.headroomAt200Accounts",
    "CaseSlaEscalationTest.headroomAt200Cases"
  ],
  "steps": {
    "plan": {
      "model": "claude-opus-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --allowedTools Read,Glob,Grep"
    },
    "implement": {
      "model": "claude-sonnet-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --permission-mode acceptEdits --allowedTools Read,Edit,Write,Glob,Grep"
    },
    "learn": {
      "model": "claude-sonnet-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --tools \"\""
    },
    "retro": {
      "model": "claude-opus-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --allowedTools Read,Glob,Grep"
    },
    "audit": {
      "model": "claude-opus-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --permission-mode acceptEdits --allowedTools Read,Write,\"Bash(bun cli/anchor.ts check-findings:*)\""
    },
    "verify": {
      "model": "claude-sonnet-5-5",
      "command": "claude -p --output-format json --model \"$MODEL\" --permission-mode acceptEdits --allowedTools Read,Write,\"Bash(bun cli/anchor.ts run-scenario:*)\",\"Bash(sf data query:*)\""
    }
  },
  "maxDiscards": 5,
  "weights": {
    "PMD": 1,
    "Graph Engine": 1,
    "Tests passing": 1,
    "Code coverage": 1,
    "Test run time": 1,
    "Limit headroom": 1,
    "Resource efficiency": 1
  },
  "margins": {
    "PMD": 0.5,
    "Graph Engine": 0.5,
    "Tests passing": 0,
    "Code coverage": 0,
    "Test run time": 3,
    "Limit headroom": 3,
    "Resource efficiency": 1
  },
  "streamline": [
    {
      "app": ["force-app/main/default/classes/AccountHealthRollup.cls"],
      "classes": [
        "force-app/main/default/classes/AccountHealthRollup.cls",
        "force-app/main/default/classes/Fixtures.cls"
      ],
      "scenarios": "apex/streamline/scenarios/AccountHealthRollupTest.apex",
      "variants": {
        "correctness": "new AccountHealthRollupTest().runCorrectness();",
        "headroom": "new AccountHealthRollupTest().runHeadroom();"
      },
      "runCounts": {
        "AccountHealthRollupTest.ratesEveryAccount": 9
      }
    },
    {
      "app": ["force-app/main/default/classes/CaseSlaEscalation.cls"],
      "classes": [
        "force-app/main/default/classes/AccountHealthRollup.cls",
        "force-app/main/default/classes/CaseSlaEscalation.cls",
        "force-app/main/default/classes/CaseFixtures.cls"
      ],
      "scenarios": "apex/streamline/scenarios/CaseSlaEscalationTest.apex",
      "variants": {
        "caseCorrectness": "new CaseSlaEscalationTest().runCorrectness();",
        "caseHeadroom": "new CaseSlaEscalationTest().runHeadroom();"
      },
      "runCounts": {
        "CaseSlaEscalationTest.escalatesEveryBreachedCase": 12
      }
    }
  ]
}
